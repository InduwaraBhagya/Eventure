<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient fill with purple shades -->
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#D36FFF"
        android:centerColor="#A529BA"
        android:endColor="#471052" />

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Padding (applies to some views that respect it) -->
    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />
</shape>
